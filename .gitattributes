* text=auto

# Source and configuration files use stable LF endings across platforms.
*.py text eol=lf
*.dart text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.xml text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.swift text eol=lf
*.plist text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# Native Windows launchers retain CRLF endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.apk binary
*.aab binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.dll binary
*.so binary
*.dylib binary
