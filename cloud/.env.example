# Copiar como .env solo en el servidor. Nunca subir secretos reales.
POSTGRES_DB=doccione
POSTGRES_USER=doccione
POSTGRES_PASSWORD=change-this-to-a-long-unique-password
DATABASE_URL=postgresql+psycopg://doccione:change-this-to-a-long-unique-password@db:5432/doccione
JWT_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_TOKEN=replace-with-a-second-long-random-secret
DOMAIN=api.example.com
PUBLIC_ORIGIN=https://api.example.com
