# ── WhatsApp Business Cloud API ──────────────────────────────────────
# Copiar este archivo como .env y completar las credenciales reales.
# .env está en .gitignore; no subir credenciales al repositorio.

# Habilitar integración (true/false)
WHATSAPP_ENABLED=false

# Token de acceso permanente de Meta (System User o Permanent Token)
WHATSAPP_ACCESS_TOKEN=

# ID del número de teléfono (Phone Number ID)
WHATSAPP_PHONE_NUMBER_ID=

# ID de la cuenta de WhatsApp Business
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Token de verificación para el webhook (elegir un string secreto)
WHATSAPP_VERIFY_TOKEN=

# App Secret de la Meta App (para verificar firmas del webhook)
WHATSAPP_APP_SECRET=

# Versión de la API de Meta (ej: v22.0)
WHATSAPP_API_VERSION=v22.0

# Puerto local para el servidor de webhook
WHATSAPP_WEBHOOK_PORT=8767

# Validar firma HMAC de los webhooks (true/false)
# Deshabilitar solo para desarrollo local con ngrok
WHATSAPP_VERIFY_SIGNATURE=true

# Tamaño máximo del cuerpo del webhook en bytes (1 MB por defecto)
WHATSAPP_MAX_WEBHOOK_BYTES=1048576

# Máximo de reintentos para eventos fallidos del webhook
WHATSAPP_WEBHOOK_MAX_ATTEMPTS=5

# Timeout HTTP para llamadas a la API de Meta (segundos)
WHATSAPP_HTTP_TIMEOUT_SECONDS=15

# Intervalo de sondeo del worker de outbox (segundos)
WHATSAPP_OUTBOX_POLL_SECONDS=2

# Tamaño del lote de procesamiento del outbox
WHATSAPP_OUTBOX_BATCH_SIZE=20

# Máximo de reintentos para envío de mensajes salientes
WHATSAPP_OUTBOX_MAX_ATTEMPTS=5

# Base para backoff exponencial (segundos)
WHATSAPP_OUTBOX_RETRY_BASE_SECONDS=5

# Límite máximo para backoff exponencial (segundos)
WHATSAPP_OUTBOX_RETRY_MAX_SECONDS=900

# Timeout para recuperar elementos trabados en processing (segundos)
WHATSAPP_OUTBOX_PROCESSING_TIMEOUT_SECONDS=300

# ── Embedded Signup / Onboarding (coexistencia) ─────────────────────
# Se actualizan automáticamente tras el onboarding exitoso.
WHATSAPP_WABA_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_CONFIGURATION_ID=

# URL publica del tunel HTTPS para Embedded Signup (ej: https://xxx.trycloudflare.com)
# Se configura automaticamente al usar tools/start_whatsapp_onboarding.ps1
WHATSAPP_ONBOARDING_PUBLIC_URL=
